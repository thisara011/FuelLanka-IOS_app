{
  "hosting": {
    "public": "firebase-public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
